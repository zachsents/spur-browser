{
  "name": "spur-browser",
  "version": "0.1.0",
  "private": true,
  "description": "This machine's Chrome, driven by Agent Quick Browse, as a Switch spur.",
  "license": "MIT",
  "repository": "github:zachsents/spur-browser",
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint --type-aware --fix --fix-suggestions",
    "format": "oxfmt --write .",
    "fix": "bun run lint && bun run format",
    "check": "bun run typecheck && bun run fix"
  },
  "dependencies": {
    "agent-quick-browse": "^0.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "ultracite": "^8.3.1"
  },
  "spur": {
    "name": "browser",
    "main": "src/main.ts",
    "needs": [
      "browser"
    ]
  }
}
